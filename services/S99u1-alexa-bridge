#!/bin/sh
# U1 Companion optional Alexa bridge
case "$1" in
start) start-stop-daemon -S -q -b -m -p /run/u1-alexa-bridge.pid -x /usr/bin/python3 -- /home/lava/u1-addons/filament-ui/u1-alexa-bounded-launch.py ;;
stop) /usr/bin/python3 /home/lava/u1-addons/filament-ui/u1-service-stop.py S99u1-alexa-bridge ;;
*) exit 2 ;;
esac
